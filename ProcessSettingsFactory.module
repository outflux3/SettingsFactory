<?php namespace ProcessWire;

/**
 * ProcessSettingsFactory
 *
 * The admin screen for one settings page: builds a form from the page's definition
 * file, fills it from SettingsFactory's stored values, and saves what is submitted.
 *
 * @author Macrura
 * @license GPL-2.0
 *
 */
class ProcessSettingsFactory extends Process {

	public static function getModuleInfo() {
		return array(
			'title' => __('Process Settings Factory', __FILE__),
			'summary' => __('Unlimited settings pages.', __FILE__),
			'version' => '1.1.0',
			'author' => 'Macrura',
			'permanent' => false,
			'autoload' => false,
			'icon' => 'check-square-o',
			'requires' => 'SettingsFactory',
			'permission' => 'settings-factory',
			'permissionMethod' => 'hasSettingsPagePermission',
			'permissions' => array('settings-factory' => 'Access settings factory pages'),
		);
	}

	/**
	 * @var SettingsFactory|null
	 *
	 */
	protected $factory = null;

	public function init() {
		parent::init();
		$this->factory = $this->wire()->modules->get('SettingsFactory');
	}

	/**
	 * Show the settings form, or save it
	 *
	 * @return string
	 *
	 */
	public function ___execute() {

		$form = $this->buildForm();

		if($this->wire()->input->post('submit_save') && $form->get('submit_save')) {
			$this->processForm($form);
			$this->wire()->session->redirect("./");
			return '';
		}

		return $form->render() . $this->renderFooter();
	}

	/**
	 * Access check: a permission named like the settings page, else settings-factory
	 *
	 * Create a permission with the same name as a settings page (e.g. "theme-settings")
	 * to limit that screen to the roles that have it.
	 *
	 * @param array $data
	 * @return bool
	 *
	 */
	public static function hasSettingsPagePermission(array $data) {
		$user = isset($data['user']) ? $data['user'] : null;
		$wire = isset($data['wire']) ? $data['wire'] : null;
		$page = isset($data['page']) ? $data['page'] : null;
		if(!$user instanceof User || !$wire) return false;
		if($user->isSuperuser()) return true;
		$permission = null;
		if($page instanceof Page && $page->id && $page->name) $permission = $wire->permissions->get($page->name);
		if(!$permission || !$permission->id) $permission = 'settings-factory';
		return $user->hasPermission($permission);
	}

	/**
	 * Build the settings form for the current admin page
	 *
	 * @return InputfieldForm
	 *
	 */
	protected function buildForm() {

		$modules = $this->wire()->modules;
		$page = $this->wire()->page;
		$key = $page->name;

		/** @var InputfieldForm $form */
		$form = $modules->get('InputfieldForm');
		$form->attr('id', 'ProcessSettingsFactory');
		$form->attr('method', 'post');
		$form->attr('action', './');

		try {
			$definition = $this->factory->loadDefinition($page);
		} catch(\Throwable $e) {
			/** @var InputfieldMarkup $f */
			$f = $modules->get('InputfieldMarkup');
			$f->attr('name', 'instructions');
			$f->label = $this->_('Instructions');
			$f->icon = 'warning';
			$f->value = '<p>' . $this->wire()->sanitizer->entities($e->getMessage()) . '</p><p>' .
				$this->_('Please check that you have correctly specified a path to a valid json or php file that defines your inputfields.') . '</p>';
			$form->add($f);
			return $form; // no Save button: saving without a definition would wipe the stored values
		}

		// move the definition's top-level items into the form, so WireTabs are direct children
		foreach($definition->children()->getArray() as $child) $form->add($child);

		$stored = $this->factory->getStored($key);
		if($stored === null) $stored = array();
		$languages = $this->getNonDefaultLanguages();

		foreach($this->factory->getValueInputfields($form) as $name => $f) {
			if(array_key_exists($name, $stored)) $this->setInputfieldValue($f, $stored[$name]);
			if($f->getSetting('useLanguages')) {
				foreach($languages as $language) {
					$langKey = $name . '__' . $language->id;
					if(array_key_exists($langKey, $stored)) $f->set('value' . $language->id, $stored[$langKey]);
				}
			}
		}

		if($this->hasWireTabs($form)) {
			$modules->get('JqueryWireTabs');
			$this->wire()->config->scripts->append($this->wire()->config->urls->SettingsFactory . 'wiretabs-init.js');
		}

		/** @var InputfieldSubmit $f */
		$f = $modules->get('InputfieldSubmit');
		$f->attr('name', 'submit_save');
		$f->attr('value', $this->_('Save'));
		$f->addClass('head_button_clone');
		$f->icon = 'save';
		$form->add($f);

		return $form;
	}

	/**
	 * Put a stored value back into an inputfield
	 *
	 * @param Inputfield $f
	 * @param mixed $value
	 *
	 */
	protected function setInputfieldValue(Inputfield $f, $value) {
		if($f instanceof InputfieldCheckbox) {
			// a checkbox's value attribute is what it submits; its state is "checked"
			$checked = !($value === null || $value === false || $value === '' || $value === 0 || $value === '0'
				|| "$value" === (string) $f->uncheckedValue);
			$f->attr('checked', $checked ? 'checked' : '');
			return;
		}
		if($f instanceof InputfieldPage && is_array($value)) {
			// stored as an array of IDs; InputfieldPage accepts "123|456" and turns it into a PageArray
			$value = implode('|', array_filter(array_map('intval', $value)));
		}
		$f->attr('value', $value === null ? '' : $value);
	}

	/**
	 * Save the submitted form
	 *
	 * Replaces everything stored for this settings page, as before: fields removed
	 * from the definition file drop out of the stored data on the next save.
	 *
	 * @param InputfieldForm $form
	 *
	 */
	protected function processForm(InputfieldForm $form) {

		$page = $this->wire()->page;
		$form->processInput($this->wire()->input->post);
		$languages = $this->getNonDefaultLanguages();

		$values = array();
		foreach($this->factory->getValueInputfields($form) as $name => $f) {
			$values[$name] = $this->factory->normalizeValue($f->attr('value'));
			if($f->getSetting('useLanguages')) {
				foreach($languages as $language) {
					$values[$name . '__' . $language->id] = $this->factory->normalizeValue($f->get('value' . $language->id));
				}
			}
		}

		if($this->factory->saveSettings($page->name, $values, true)) {
			$this->message(sprintf($this->_('Saved: %s'), $page->title));
		} else {
			$this->error(sprintf($this->_('Could not save: %s'), $page->title));
		}
	}

	/**
	 * Does the form contain a WireTab wrapper?
	 *
	 * @param InputfieldWrapper $form
	 * @return bool
	 *
	 */
	protected function hasWireTabs(InputfieldWrapper $form) {
		foreach($form->getAll(array('withWrappers' => true)) as $f) {
			if($f instanceof InputfieldWrapper && $f->hasClass('WireTab')) return true;
		}
		return false;
	}

	/**
	 * @return Language[]
	 *
	 */
	protected function getNonDefaultLanguages() {
		$languages = $this->wire()->languages;
		if(!$languages) return array();
		$list = array();
		foreach($languages as $language) {
			if(!$language->isDefault()) $list[] = $language;
		}
		return $list;
	}

	/**
	 * Superuser footer: version, definition file, edit link, API call
	 *
	 * @return string
	 *
	 */
	protected function renderFooter() {
		if(!$this->wire()->user->isSuperuser()) return '';
		$sanitizer = $this->wire()->sanitizer;
		$page = $this->wire()->page;
		$info = $this->wire()->modules->getModuleInfoVerbose('SettingsFactory');
		$filepath = (string) $page->get(SettingsFactory::pathField);
		$file = strlen($filepath)
			? sprintf($this->_('Using %s'), '<code>' . $sanitizer->entities($filepath) . '</code>')
			: $this->_('No Path Specified.');
		$api = "<code>\$modules->get('SettingsFactory')->getSettings('" . $sanitizer->entities($page->name) . "')</code>";
		return "<p class='version detail'><i class='fa fa-check-square-o'></i> Settings Factory v$info[versionStr] | $file" .
			" | <a href='{$page->editUrl}' target='_blank'>" . $this->_('Edit Process Settings') . "</a>" .
			" | $api</p>";
	}

}
